secrets/
*.pem
*.key
id_rsa*
id_ed25519*

# Личные настройки Claude Code
.claude/settings.local.json

# Временные файлы и логи
*.tmp
*.log
*.bak
*.cache

# Кеш сырых данных мониторинга (vacancies API) — не коммитить
.cache/

# Редакторы и IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Зависимости (на будущее)
node_modules/
__pycache__/
*.pyc

# Сырые выгрузки мониторинга зарплат (HR Assistant) — не коммитить
materials/raw/
materials/*.csv
materials/*.xlsx
