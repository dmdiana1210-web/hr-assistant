# Редакторы и IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Зависимости (на будущее)
node_modules/
__pycache__/
*.pyc

# Опросник личных дел — данные сотрудников, не коммитить
Опросник личных дел/*.csv
Опросник личных дел/otchet/
Опросник личных дел.zip
